# PianoForge backend settings (all variables use the PF_ prefix).
# Copy to backend/.env for local runs. Never commit real secrets.

PF_ENV=dev
PF_LOG_LEVEL=INFO
PF_LOG_JSON=false

# HTTP
PF_CORS_ORIGINS=http://localhost:3000
PF_TRUSTED_HOSTS=localhost,127.0.0.1

# Database / Redis
PF_DATABASE_URL=postgresql+psycopg://pianoforge:pianoforge@localhost:5432/pianoforge
PF_REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO in development)
PF_S3_ENDPOINT_URL=http://localhost:9000
# Host the browser uses for presigned URLs, if different from the internal endpoint.
PF_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
PF_S3_ACCESS_KEY=minioadmin
PF_S3_SECRET_KEY=minioadmin
PF_S3_BUCKET=pianoforge

# Auth: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
PF_JWT_SECRET=dev-only-change-me-0123456789abcdef
PF_COOKIE_SECURE=false

# Upload / retention policy
PF_UPLOAD_MAX_BYTES=52428800
PF_RAW_RETENTION_DAYS=7

# Analysis engine fallback chains (first available engine wins)
PF_SEPARATOR_CHAIN=demucs,hpss,passthrough
PF_TRANSCRIBER_CHAIN=basic_pitch,pyin
PF_BEAT_TRACKER_CHAIN=madmom,librosa,fixed
PF_ENGRAVER_CHAIN=verovio,musescore
PF_RENDERER_CHAIN=fluidsynth,synth
# Piano SoundFont for FluidSynth (defaults to the first one found under /usr/share/sounds/sf2)
# PF_SOUNDFONT_PATH=/usr/share/sounds/sf2/SalamanderGrandPiano.sf2
PF_DEMUCS_MODEL=htdemucs
PF_DEMUCS_DEVICE=auto

# Worker scratch space (use a tmpfs in containers)
PF_WORK_DIR=/tmp/pianoforge
