# PianoForge local stack (docker compose). Copy to infra/.env or run `make env`,
# which fills the secrets with random values.

# Browser entry point (Caddy). Change APP_PORT if 3000 is taken.
APP_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Object storage, reached directly by the browser for uploads and downloads.
STORAGE_PORT=9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=pianoforge
STORAGE_SECRET_KEY=change-me-storage-secret
S3_BUCKET=pianoforge

POSTGRES_USER=pianoforge
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=pianoforge

# At least 32 characters.
PF_JWT_SECRET=change-me-jwt-secret-at-least-32-characters

# true: Demucs + Basic Pitch in the worker image (larger image, much better melody).
WITH_ML=true
# Parallel CPU tasks in the cpu worker.
CPU_CONCURRENCY=2
